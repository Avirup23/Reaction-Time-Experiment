library(readxl)
df <- read_excel('C:\\Users\\chakr\\Desktop\\Academics\\_assignments_and_programs\\Python\\DOE\\data.xlsx')
df = df[df$Hand = "right"]
df = df[df$Hand == "right"]
df = df[,df$Hand == "right"]
df = df[df$Hand == "right",]
df$Block   <- as.factor(df$Block)
df$Music   <- as.factor(df$Music)
df$Color   <- as.factor(df$Color)
# A standard linear model - this will not fail
raw_fit <- lm(RT ~ Block + Music * Color, data = df)
raw_summary <- anova(raw_fit)
print(raw_summary)
