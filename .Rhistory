library(readxl)
library(nlme)
df <- read_excel('C:\\Users\\chakr\\Desktop\\Academics\\_assignments_and_programs\\Python\\DOE\\data.xlsx')
df <- df[df$Hand == "right", ]
df$Block <- as.factor(df$Block)
df$Music <- as.factor(df$Music)
df$Color <- as.factor(df$Color)
# ── 1. Homoscedastic baseline (your original model, refitted via gls) ──────────
fit_homo <- gls(RT ~ Block + Music * Color,
data   = df,
method = "REML")
# ── 2. Heteroscedastic model: separate variance per Block ──────────────────────
fit_hetero <- gls(RT ~ Block + Music * Color,
data     = df,
weights  = varIdent(form = ~ 1 | Block),
method   = "REML")
# ── 3. Compare: is heteroscedasticity warranted? ───────────────────────────────
anova(fit_homo, fit_hetero)   # LRT — lower AIC/BIC + p < .05 → prefer hetero
# ── 4. Summaries ──────────────────────────────────────────────────────────────
summary(fit_hetero)
View(df)
library(readxl)
library(nlme)
df <- read_excel('C:\\Users\\chakr\\Desktop\\Academics\\_assignments_and_programs\\Python\\DOE\\data.xlsx')
df <- df[df$Hand == "right", ]
df$Subject <- as.factor(df$Subject)
df$Music <- as.factor(df$Music)
df$Color <- as.factor(df$Color)
# ── 1. Homoscedastic baseline (your original model, refitted via gls) ──────────
fit_homo <- gls(RT ~ Subject + Music * Color,
data   = df,
method = "REML")
# ── 2. Heteroscedastic model: separate variance per Subject ──────────────────────
fit_hetero <- gls(RT ~ Subject + Music * Color,
data     = df,
weights  = varIdent(form = ~ 1 | Subject),
method   = "REML")
# ── 3. Compare: is heteroscedasticity warranted? ───────────────────────────────
anova(fit_homo, fit_hetero)   # LRT — lower AIC/BIC + p < .05 → prefer hetero
# ── 4. Summaries ──────────────────────────────────────────────────────────────
summary(fit_homo)
summary(fit_hetero)
# Estimated per-Subject SDs (relative to reference Subject)
plot(fit_hetero, resid(., type = "normalized") ~ fitted(.),
abline = 0, main = "Normalized residuals vs fitted")
qqnorm(fit_hetero, ~ resid(., type = "normalized"))
# ── 4. Summaries ──────────────────────────────────────────────────────────────
Anova(fit_homo, type = "III")
library(car)
# ── 4. Summaries ──────────────────────────────────────────────────────────────
Anova(fit_homo, type = "III")
summary(fit_hetero)
# ── 4. Summaries ──────────────────────────────────────────────────────────────
Anova(fit_homo, type = "III")
Anova(fit_homo, type = "III", test.statistic = "F")
summary(fit_hetero)
library(readxl)
library(nlme)
library(car)
# ── Data Loading & Preprocessing ──────────────────────────────────────────────
df <- read_excel('C:\\Users\\chakr\\Desktop\\Academics\\_assignments_and_programs\\Python\\DOE\\data.xlsx')
df$Subject <- as.factor(df$Subject)
df$Music   <- as.factor(df$Music)
df$Color   <- as.factor(df$Color)
# ── Model Fitting ──────────────────────────────────────────────────────────────
fit_homo   <- gls(RT ~ Subject + Music * Color, data = df, method = "REML")
fit_hetero <- gls(RT ~ Subject + Music * Color, data = df, method = "REML",
weights = varIdent(form = ~ 1 | Subject))
# ── Model Comparison (LRT) ─────────────────────────────────────────────────────
cat("\n=== Likelihood Ratio Test: Homo vs Hetero ===\n")
anova(fit_homo, fit_hetero)
# ── ANOVA Tables ───────────────────────────────────────────────────────────────
cat("\n=== Type III ANOVA: Homoscedastic ===\n")
Anova(fit_homo, type = "III", test.statistic = "F")
cat("\n=== Type III ANOVA: Heteroscedastic ===\n")
Anova(fit_hetero, type = "III", test.statistic = "F")
# ── Coefficients & Cell Means ──────────────────────────────────────────────────
cat("\n=== Coefficients: Heteroscedastic Model ===\n")
summary(fit_hetero)$tTable
# 2x2 cell means (marginal means for Music x Color)
cat("\n=== 2x2 Cell Means ===\n")
cell_means <- tapply(df$RT, list(df$Music, df$Color), mean)
print(round(cell_means, 2))
# ── Diagnostics ────────────────────────────────────────────────────────────────
par(mfrow = c(3, 2))
# 1. Residuals vs Fitted
plot(fit_hetero,
resid(., type = "normalized") ~ fitted(.),
abline = 0,
pch = 19, col = adjustcolor("steelblue", 0.6),
xlab = "Fitted Values", ylab = "Normalized Residuals",
main = "Residuals vs Fitted")
# 2. Q-Q Plot
qqnorm(resid(fit_hetero, type = "normalized"),
main = "Q-Q Plot: Normalized Residuals",
pch = 19, col = adjustcolor("steelblue", 0.6))
qqline(resid(fit_hetero, type = "normalized"), col = "red", lwd = 2)
# 2. Q-Q Plot
qqnorm(resid(fit_hetero, type = "normalized"),
main = "Q-Q Plot: Normalized Residuals",
pch = 19, col = adjustcolor("steelblue", 0.6))
resid(fit_hetero, type = "normalized")
# 2. Q-Q Plot
qqnorm(resid(fit_hetero, type = "normalized")[1],
main = "Q-Q Plot: Normalized Residuals",
pch = 19, col = adjustcolor("steelblue", 0.6))
resid(fit_hetero, type = "normalized")[1]
# 3. Residuals vs Subject (check block balance)
boxplot(resid(fit_hetero, type = "normalized") ~ df$Subject,
main = "Residuals by Subject",
xlab = "Subject", ylab = "Normalized Residuals",
col = "lightblue", las = 2, cex.axis = 0.6)
# 4. Residuals vs Music
boxplot(resid(fit_hetero, type = "normalized") ~ df$Music,
main = "Residuals by Music",
xlab = "Music", ylab = "Normalized Residuals",
col = c("tomato", "lightgreen"))
par(mfrow = c(3, 2))
# 1. Residuals vs Fitted
plot(fit_hetero,
resid(., type = "normalized") ~ fitted(.),
abline = 0,
pch = 19, col = adjustcolor("steelblue", 0.6),
xlab = "Fitted Values", ylab = "Normalized Residuals",
main = "Residuals vs Fitted")
# 2. Q-Q Plot
qqnorm(resid(fit_hetero, type = "normalized"),
main = "Q-Q Plot: Normalized Residuals",
pch = 19, col = adjustcolor("steelblue", 0.6))
par(mfrow = c(3, 2), mar = c(5, 4, 3, 1))
# 1. Residuals vs Fitted
plot(fit_hetero,
resid(., type = "normalized") ~ fitted(.),
abline = 0,
pch = 19, col = adjustcolor("steelblue", 0.6),
xlab = "Fitted Values", ylab = "Normalized Residuals",
main = "Residuals vs Fitted")
# 2. Q-Q Plot
qqnorm(resid(fit_hetero, type = "normalized"),
main = "Q-Q Plot: Normalized Residuals",
pch = 19, col = adjustcolor("steelblue", 0.6))
pdf("diagnostics.pdf", width = 14, height = 10)
par(mfrow = c(3, 2), mar = c(5, 4, 3, 1))
# 1. Residuals vs Fitted
plot(fit_hetero,
resid(., type = "normalized") ~ fitted(.),
abline = 0,
pch = 19, col = adjustcolor("steelblue", 0.6),
xlab = "Fitted Values", ylab = "Normalized Residuals",
main = "Residuals vs Fitted")
# 2. Q-Q Plot
qqnorm(resid(fit_hetero, type = "normalized"),
main = "Q-Q Plot: Normalized Residuals",
pch = 19, col = adjustcolor("steelblue", 0.6))
qqline(resid(fit_hetero, type = "normalized"), col = "red", lwd = 2)
# 3. Residuals vs Subject (check block balance)
boxplot(resid(fit_hetero, type = "normalized") ~ df$Subject,
main = "Residuals by Subject",
xlab = "Subject", ylab = "Normalized Residuals",
col = "lightblue", las = 2, cex.axis = 0.6)
abline(h = 0, col = "red", lty = 2)
# 4. Residuals vs Music
boxplot(resid(fit_hetero, type = "normalized") ~ df$Music,
main = "Residuals by Music",
xlab = "Music", ylab = "Normalized Residuals",
col = c("tomato", "lightgreen"))
abline(h = 0, col = "red", lty = 2)
# 5. Residuals vs Color
boxplot(resid(fit_hetero, type = "normalized") ~ df$Color,
main = "Residuals by Color",
xlab = "Color", ylab = "Normalized Residuals",
col = c("tomato", "lightyellow"))
abline(h = 0, col = "red", lty = 2)
# 6. Per-subject variance estimates (heteroscedastic weights)
sigma_i <- coef(fit_hetero$modelStruct$varStruct, unconstrained = FALSE) *
fit_hetero$sigma
sigma_df <- data.frame(Subject = names(sigma_i), Sigma = sigma_i)
barplot(sigma_df$Sigma,
names.arg = sigma_df$Subject,
main = "Estimated Residual SD per Subject",
ylab = "SD (ms)", col = "steelblue",
las = 2, cex.names = 0.6)
pdf("diagnostics.pdf", width = 14, height = 10)
par(mfrow = c(3, 2), mar = c(5, 4, 3, 1))
